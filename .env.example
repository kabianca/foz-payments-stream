# Copied to .env by `make init`. Everything has a default; edit to taste.

# Files under ./data are written by the stream container as this uid so the
# host user can read and delete them. `make init` fills it in.
FOZ_UID=1000

FOZ_TOPIC=payments
FOZ_WINDOW_SECONDS=60
FOZ_ALLOWED_LATENESS_SECONDS=120
FOZ_TRIGGER_SECONDS=5
